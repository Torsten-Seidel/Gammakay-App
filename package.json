{
  "name": "tk75-konfigurator",
  "version": "1.0.0",
  "description": "Eigene Desktop-App zur Konfiguration der Gamakay TK75 TMR",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k -n vite,electron \"vite\" \"wait-on tcp:127.0.0.1:5173 && electron .\"",
    "dev:web": "vite",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build",
    "start": "vite build && electron . --dist"
  },
  "type": "commonjs",
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "@types/w3c-web-hid": "^1.0.7",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "electron": "^45.5.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "wait-on": "^9.5.1"
  },
  "productName": "TK75 Konfigurator",
  "private": true
}
